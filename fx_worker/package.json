{
  "name": "fx-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Servicio de render de motion graphics (HyperFrames): JSON -> MP4",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "FX_INTEGRATION=1 node --test tests/integration/*.test.mjs",
    "spike": "node spike/run.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant": "5.2.5",
    "@fontsource/inter": "5.2.5",
    "@fontsource/jetbrains-mono": "5.2.5",
    "@hyperframes/lint": "0.8.169",
    "@hyperframes/producer": "0.8.169",
    "gsap": "3.14.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hyperframes/player": "0.8.169"
  }
}
