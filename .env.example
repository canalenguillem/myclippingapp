# --- Base de datos ---
MARIADB_ROOT_PASSWORD=cambia_esto_root
MARIADB_DATABASE=clipping
MARIADB_USER=clipping
MARIADB_PASSWORD=cambia_esto
DATABASE_URL=mysql+pymysql://clipping:cambia_esto@mariadb:3306/clipping?charset=utf8mb4

# --- Seguridad (genera valores propios; ver README) ---
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
ALLOW_REGISTRATION=true
PUBLIC_BASE_URL=http://localhost:5074

# --- Despliegue (opcionales: vacío = valores por defecto de docker-compose.yml) ---
FRONTEND_PORT=
MEDIA_HOST_DIR=
BACKEND_DEBUG_PORT=
FX_DEBUG_PORT=
# Renders de vídeo en paralelo en todo el sistema (vacío = 1). Con 2 conviene FX_WORKERS=1 y vigilar la RAM.
RENDER_LANES=
FX_WORKERS=

# --- IA ---
OPENAI_API_KEY=
OPENAI_CLIP_MODEL=gpt-4o
AAI_API_KEY=

# --- Worker ---
WORKER_CONCURRENCY=2
FX_WORKER_URL=http://fx_worker:3000
# Worker TalkNet en GPU para «Sigue al hablante» (detecta caras y quién habla). Vacío = usa las posiciones de los speakers.
ASD_WORKER_URL=
MEDIA_DIR=/media
# Días sin actividad tras los que se borra lo pesado de un proyecto (vídeo, audio, renders; se regeneran). Vacío = 14; 0 = nunca.
MEDIA_RETENTION_DAYS=
